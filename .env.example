# ---- Required for live LLM synthesis ----
# Get a key from https://platform.openai.com/api-keys — without this, the Evidence
# Library still does REAL retrieval and shows real quoted passages, it just won't
# have a synthesized prose answer on top (and will say so honestly in the UI).
OPENAI_API_KEY=

# Optional — defaults to a fast, cost-effective model. Override if you want a different one.
OPENAI_MODEL=gpt-4o-mini

# ---- Retrieval tuning ----
# Minimum BM25 score for a passage to be treated as a real match. Raise this to be
# stricter about what counts as relevant (fewer, more confident sources); lower it
# to surface more borderline matches.
MIN_RETRIEVAL_SCORE=10

# ---- Session security ----
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ---- Role passcodes ----
# Change these before sharing the link. Each role has one shared passcode (POC-appropriate;
# not individual accounts). Pick your own values — these are just local dev defaults.
PASSCODE_CLINIC=cbp-clinic-2026
PASSCODE_RESEARCHER=cbp-research-2026
PASSCODE_NETWORK_ADMIN=cbp-network-2026
PASSCODE_EXECUTIVE=cbp-policy-2026

# ---- Server ----
# Railway sets this automatically — no need to set it yourself in Railway's dashboard.
PORT=3000
